# Mistral AI Configuration
# Get your API key from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenRouter API Configuration for Free Talk mode
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free model (default): google/gemma-7b-it:free
# Other free models available: meta-llama/llama-3-8b-instruct:free, mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL=google/gemma-7b-it:free

# Optional: Anthropic Claude API for evaluation (not currently used for mascot)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
