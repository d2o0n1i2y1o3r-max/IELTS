# Cloudflare Workers AI Configuration
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Create a token with "Cloudflare Workers AI" permissions
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# OpenRouter API Configuration for Free Talk mode
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free model (default): google/gemma-7b-it:free
# Other free models available: meta-llama/llama-3-8b-instruct:free, mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL=google/gemma-7b-it:free

# Optional: Anthropic Claude API for evaluation (not currently used for mascot)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
